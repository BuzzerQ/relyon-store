---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductCard from '../../components/homepage/ProductCard.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: products } = await supabase
    .from('products')
    .select('slug')
    .eq('is_active', true);

  if (!products || products.length === 0) return [];

  return products
    .filter((p) => Boolean(p.slug))
    .map((product) => ({
      params: { slug: product.slug },
    }));
}

const { slug } = Astro.params;

// 1. Fetch detail produk utama
const { data: product, error } = await supabase
  .from('products')
  .select('id, title, slug, category, price, original_price, thumbnail, description, is_active')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (error || !product) {
  return Astro.redirect('/404');
}

// 2. Fetch maksimal 4 produk serupa (kategori sama & aktif, selain produk ini)
const { data: relatedRaw } = await supabase
  .from('products')
  .select('id, title, slug, category, price, original_price, thumbnail')
  .eq('category', product.category)
  .eq('is_active', true)
  .neq('id', product.id)
  .limit(4);

// Format data produk serupa agar sesuai dengan props ProductCard
const relatedProducts = (relatedRaw || []).map((rel) => ({
  id: rel.id,
  title: rel.title,
  slug: rel.slug,
  category: rel.category,
  price: Number(rel.price),
  originalPrice: rel.original_price ? Number(rel.original_price) : undefined,
  thumbnail: rel.thumbnail,
}));

const formattedPrice = `Rp ${Number(product.price).toLocaleString('id-ID')}`;
const formattedOriginalPrice = product.original_price 
  ? `Rp ${Number(product.original_price).toLocaleString('id-ID')}` 
  : null;
const discountPercentage = product.original_price && Number(product.original_price) > Number(product.price)
  ? Math.round((1 - Number(product.price) / Number(product.original_price)) * 100)
  : null;
---

<MainLayout title={`${product.title} - Relyon Creative`}>
  <!-- Breadcrumb -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <nav class="flex items-center gap-2 overflow-hidden text-xs md:text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href="/" class="hover:text-relyon-blue dark:hover:text-relyon-sky">Beranda</a>
      <span>/</span>
      <a href="/katalog" class="hover:text-relyon-blue dark:hover:text-relyon-sky">Katalog</a>
      <span>/</span>
      <span class="text-relyon-dark dark:text-white font-medium line-clamp-1">{product.title}</span>
    </nav>
  </section>

  <!-- Product Detail -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Image & Badges -->
      <div class="lg:col-span-6 space-y-4">
        <div class="relative bg-white dark:bg-relyon-darkcard rounded-3xl border border-slate-200 dark:border-slate-800 p-3 shadow-lg overflow-hidden group">
          <img 
            src={product.thumbnail} 
            alt={product.title} 
            class="w-full h-[320px] md:h-[420px] object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500"
          />
          <span class="absolute top-6 left-6 bg-relyon-dark/80 backdrop-blur-md text-white px-3 py-1 rounded-lg text-xs font-semibold tracking-wide">
            {product.category}
          </span>
        </div>

        <div class="grid grid-cols-3 gap-3 pt-2">
          <div class="bg-slate-50 dark:bg-relyon-darkcard border border-slate-200 dark:border-slate-800 rounded-2xl p-3 text-center">
            <span class="text-xl">⚡</span>
            <p class="text-[11px] md:text-xs font-semibold text-relyon-dark dark:text-white mt-1">Proses Terarah</p>
            <p class="text-[10px] text-slate-400">Maks. 1×24 jam</p>
          </div>
          <div class="bg-slate-50 dark:bg-relyon-darkcard border border-slate-200 dark:border-slate-800 rounded-2xl p-3 text-center">
            <span class="text-xl">🛡️</span>
            <p class="text-[11px] md:text-xs font-semibold text-relyon-dark dark:text-white mt-1">100% Original</p>
            <p class="text-[10px] text-slate-400">Lisensi/File Resmi</p>
          </div>
          <div class="bg-slate-50 dark:bg-relyon-darkcard border border-slate-200 dark:border-slate-800 rounded-2xl p-3 text-center">
            <span class="text-xl">💬</span>
            <p class="text-[11px] md:text-xs font-semibold text-relyon-dark dark:text-white mt-1">Support WA</p>
            <p class="text-[10px] text-slate-400">Siap bantu setup</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Meta & Actions -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="inline-block bg-relyon-blue/10 dark:bg-relyon-sky/10 text-relyon-blue dark:text-relyon-sky text-xs font-bold px-3 py-1 rounded-full mb-3">
            {product.category}
          </span>
          <h1 class="text-2xl md:text-4xl font-extrabold text-relyon-dark dark:text-white leading-tight">
            {product.title}
          </h1>
        </div>

        <div class="bg-slate-50 dark:bg-relyon-darkcard/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-5">
          <div class="flex flex-wrap items-baseline gap-3">
            <span class="text-3xl md:text-4xl font-black text-relyon-blue dark:text-relyon-sky">{formattedPrice}</span>
            {formattedOriginalPrice && <span class="text-base text-slate-400 line-through">{formattedOriginalPrice}</span>}
            {discountPercentage && <span class="rounded-lg bg-relyon-yellow/20 px-2 py-1 text-xs font-bold text-amber-700">Hemat {discountPercentage}%</span>}
          </div>
          <p class="mt-2 text-xs text-slate-400">Harga untuk satu produk sesuai deskripsi.</p>
        </div>

        <div class="space-y-2">
          <h3 class="text-sm font-bold text-relyon-dark dark:text-white uppercase tracking-wider">Deskripsi Layanan & Produk</h3>
          <p class="text-sm md:text-base text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-line">
            {product.description || 'Tidak ada deskripsi rinci untuk produk ini.'}
          </p>
        </div>

        <div class="pt-4 space-y-3">
          <button 
            id="add-to-cart-btn"
            data-id={product.id}
            data-title={product.title}
            data-price={product.price}
            data-thumbnail={product.thumbnail}
            data-category={product.category}
            class="w-full bg-relyon-blue hover:bg-relyon-dark text-white font-bold py-4 rounded-2xl shadow-xl shadow-relyon-blue/20 hover:shadow-2xl transition-all duration-300 text-center flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>+ Tambahkan ke Keranjang</span>
          </button>

          <a 
            href={`https://wa.me/6282112709889?text=${encodeURIComponent(`Halo Admin Relyon Creative, saya ingin bertanya tentang produk: ${product.title}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 font-semibold py-3.5 rounded-2xl border border-emerald-200 dark:border-emerald-800 transition-colors text-center flex items-center justify-center gap-2 text-sm"
          >
            <span>💬 Tanya Admin via WhatsApp</span>
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- Section Produk Serupa Dinamis dari Database -->
  {relatedProducts && relatedProducts.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-xl md:text-2xl font-bold text-relyon-dark dark:text-white mb-6">
        Produk Serupa yang Mungkin Kamu Suka
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relatedProducts.map((relProduct) => (
          <ProductCard {...relProduct} />
        ))}
      </div>
    </section>
  )}
</MainLayout>

<script>
  import { addToCart } from '../../lib/cartStore';

  document.addEventListener('DOMContentLoaded', () => {
    const addToCartBtn = document.getElementById('add-to-cart-btn');

    addToCartBtn?.addEventListener('click', () => {
      addToCart({
        id: addToCartBtn.getAttribute('data-id') || '',
        title: addToCartBtn.getAttribute('data-title') || '',
        price: Number(addToCartBtn.getAttribute('data-price') || 0),
        thumbnail: addToCartBtn.getAttribute('data-thumbnail') || '',
        category: addToCartBtn.getAttribute('data-category') || '',
      });

      window.dispatchEvent(new CustomEvent('open-cart-drawer'));
    });
  });
</script>