---
import '../../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Login Admin - Relyon Creative</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen bg-[#F6FAFE] font-sans text-relyon-dark antialiased">
    <main class="min-h-screen lg:grid lg:grid-cols-[1.05fr_0.95fr]">
      <section class="relative hidden overflow-hidden bg-relyon-dark px-12 py-10 text-white lg:flex lg:flex-col lg:justify-between">
        <div class="absolute -left-28 top-24 h-80 w-80 rounded-full bg-relyon-blue/30 blur-3xl"></div>
        <div class="absolute -bottom-20 right-0 h-96 w-96 rounded-full bg-relyon-sky/20 blur-3xl"></div>
        <div class="absolute right-16 top-20 h-3 w-3 rounded-full bg-relyon-yellow"></div>

        <a href="/" class="relative z-10 flex w-fit items-center gap-3" aria-label="Kembali ke beranda Relyon Creative">
          <span class="relative grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-relyon-blue to-relyon-sky text-xl font-bold shadow-lg shadow-relyon-blue/30">
            R
            <span class="absolute -bottom-1 -right-1 h-3.5 w-3.5 rounded-sm bg-relyon-yellow"></span>
          </span>
          <span><strong class="block text-xl leading-none">Relyon</strong><span class="mt-1 block text-[9px] font-semibold uppercase tracking-[0.35em] text-relyon-sky">Creative</span></span>
        </a>

        <div class="relative z-10 max-w-xl">
          <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-relyon-ice">
            <span class="h-2 w-2 rounded-full bg-relyon-yellow"></span> Secure workspace
          </span>
          <h1 class="text-4xl font-bold leading-tight xl:text-5xl">Creative solutions that drive <span class="text-relyon-sky">real impact.</span></h1>
          <p class="mt-5 max-w-lg text-sm leading-7 text-slate-300">Kelola katalog dan aset digital Relyon Creative dari satu tempat yang aman dan sederhana.</p>

          <div class="mt-10 grid grid-cols-3 gap-3">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4"><span class="mb-3 grid h-9 w-9 place-items-center rounded-xl bg-relyon-blue/20 text-relyon-sky">✦</span><p class="text-xs font-semibold">Creative</p><p class="mt-1 text-[10px] text-slate-400">Strategy</p></div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4"><span class="mb-3 grid h-9 w-9 place-items-center rounded-xl bg-relyon-blue/20 text-relyon-sky">◇</span><p class="text-xs font-semibold">Smart</p><p class="mt-1 text-[10px] text-slate-400">Solutions</p></div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4"><span class="mb-3 grid h-9 w-9 place-items-center rounded-xl bg-relyon-blue/20 text-relyon-yellow">↗</span><p class="text-xs font-semibold">Real</p><p class="mt-1 text-[10px] text-slate-400">Impact</p></div>
          </div>
        </div>

        <p class="relative z-10 text-[11px] text-slate-400">© 2026 Relyon Creative. All rights reserved.</p>
      </section>

      <section class="flex min-h-screen items-center justify-center px-5 py-10 sm:px-10 lg:px-16">
        <div class="w-full max-w-md">
          <a href="/" class="mb-12 flex w-fit items-center gap-3 lg:hidden">
            <span class="relative grid h-10 w-10 place-items-center rounded-2xl bg-gradient-to-br from-relyon-blue to-relyon-sky font-bold text-white">R<span class="absolute -bottom-1 -right-1 h-3 w-3 rounded-sm bg-relyon-yellow"></span></span>
            <span class="font-bold">Relyon Creative</span>
          </a>

          <div class="mb-8">
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-relyon-blue">Admin Portal</p>
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Selamat datang kembali</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Masuk menggunakan akun admin yang sudah terdaftar.</p>
          </div>

          <div id="login-error" role="alert" class="mb-5 hidden rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

          <form id="admin-login-form" class="space-y-5">
            <div>
              <label for="admin-email" class="mb-2 block text-sm font-semibold">Email</label>
              <input id="admin-email" type="email" autocomplete="email" required placeholder="nama@email.com" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm shadow-sm outline-none transition focus:border-relyon-blue focus:ring-4 focus:ring-relyon-blue/10" />
            </div>
            <div>
              <label for="admin-password" class="mb-2 block text-sm font-semibold">Password</label>
              <div class="relative">
                <input id="admin-password" type="password" autocomplete="current-password" required placeholder="Masukkan password" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 pr-16 text-sm shadow-sm outline-none transition focus:border-relyon-blue focus:ring-4 focus:ring-relyon-blue/10" />
                <button id="toggle-password" type="button" class="absolute inset-y-0 right-0 px-4 text-xs font-semibold text-slate-500 hover:text-relyon-blue">Lihat</button>
              </div>
            </div>
            <button id="login-submit" type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-relyon-blue py-3.5 text-sm font-semibold text-white shadow-lg shadow-relyon-blue/20 transition hover:-translate-y-0.5 hover:bg-relyon-dark disabled:cursor-not-allowed disabled:opacity-60">
              <span id="login-label">Masuk ke Dashboard</span><span aria-hidden="true">→</span>
            </button>
          </form>

          <div class="mt-8 flex items-center justify-between border-t border-slate-200 pt-5 text-xs text-slate-500">
            <a href="/" class="font-medium hover:text-relyon-blue">← Kembali ke website</a><span>Protected access</span>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('admin-login-form') as HTMLFormElement;
  const emailInput = document.getElementById('admin-email') as HTMLInputElement;
  const passwordInput = document.getElementById('admin-password') as HTMLInputElement;
  const submitButton = document.getElementById('login-submit') as HTMLButtonElement;
  const submitLabel = document.getElementById('login-label') as HTMLSpanElement;
  const errorBox = document.getElementById('login-error') as HTMLDivElement;
  const togglePassword = document.getElementById('toggle-password') as HTMLButtonElement;

  function showError(message: string) { errorBox.textContent = message; errorBox.classList.remove('hidden'); }
  function setLoading(loading: boolean) { submitButton.disabled = loading; submitLabel.textContent = loading ? 'Memeriksa akses...' : 'Masuk ke Dashboard'; }

  togglePassword.addEventListener('click', () => {
    const showing = passwordInput.type === 'text';
    passwordInput.type = showing ? 'password' : 'text';
    togglePassword.textContent = showing ? 'Lihat' : 'Tutup';
  });

  if (new URLSearchParams(window.location.search).get('error') === 'unauthorized') showError('Akun ini tidak memiliki akses admin.');

  const { data: { session } } = await supabase.auth.getSession();
  if (session) {
    const { data: allowed } = await supabase.rpc('is_admin');
    if (allowed) window.location.replace('/admin');
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.classList.add('hidden');
    setLoading(true);

    const { error } = await supabase.auth.signInWithPassword({ email: emailInput.value.trim(), password: passwordInput.value });
    if (error) { showError('Email atau password salah. Silakan periksa kembali.'); setLoading(false); return; }

    const { data: allowed, error: accessError } = await supabase.rpc('is_admin');
    if (accessError || !allowed) {
      await supabase.auth.signOut();
      showError('Akun ini tidak memiliki akses admin.');
      setLoading(false);
      return;
    }

    window.location.replace('/admin');
  });
</script>