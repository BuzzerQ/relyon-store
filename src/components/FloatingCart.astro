---

<button
  id="floating-cart-btn"
  class="fixed bottom-6 right-6 z-40 bg-relyon-blue hover:bg-relyon-dark text-white p-4 rounded-full shadow-2xl shadow-relyon-blue/40 flex items-center justify-center transition-all hover:scale-105 active:scale-95 group lg:hidden"
  aria-label="Keranjang Belanja"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
  </svg>
  <span 
    id="floating-cart-count"
    class="absolute -top-1 -right-1 w-6 h-6 bg-relyon-yellow text-relyon-dark text-xs font-bold rounded-full flex items-center justify-center border-2 border-white dark:border-relyon-darkcard"
  >
    0
  </span>
</button>

<script>
  import { getCart, type CartItem } from '../lib/cartStore';

  const countEl = document.getElementById('floating-cart-count');
  const floatBtn = document.getElementById('floating-cart-btn');

  function updateFloatCount() {
    const cart = getCart();
    const totalItems = cart.reduce((acc: number, item: CartItem) => acc + item.quantity, 0);
    if (countEl) {
      countEl.innerText = totalItems.toString();
    }
  }

  updateFloatCount();
  window.addEventListener('cart-updated', updateFloatCount);

  floatBtn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('cart-updated'));
  });
</script>
