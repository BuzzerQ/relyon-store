---
---

<div id="checkout-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden transition-opacity" aria-hidden="true"></div>

<div id="checkout-modal" class="fixed inset-x-3 top-1/2 -translate-y-1/2 mx-auto w-auto max-w-lg max-h-[calc(100dvh-1.5rem)] overflow-y-auto bg-white dark:bg-relyon-darkcard rounded-2xl shadow-2xl z-50 p-5 sm:p-6 hidden transition-all" role="dialog" aria-modal="true" aria-labelledby="checkout-title" aria-hidden="true">
  
  <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <span class="text-xl">💳</span>
      <h3 id="checkout-title" class="font-bold text-lg text-relyon-dark dark:text-white">Detail Pemesanan</h3>
    </div>
    <button id="close-checkout-modal-btn" type="button" aria-label="Tutup detail pemesanan" class="p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-white rounded-lg">
      ✕
    </button>
  </div>

  <form id="checkout-form" class="mt-5 space-y-4">
    <div>
      <label for="customer-name" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Nama Lengkap</label>
      <input 
        type="text" 
        id="customer-name" 
        required 
        minlength="2"
        maxlength="80"
        autocomplete="name"
        placeholder="Contoh: Budi Santoso"
        class="w-full bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm text-relyon-dark dark:text-white focus:outline-none focus:border-relyon-blue"
      />
    </div>

    <div>
      <label for="customer-email" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Email Aktif</label>
      <input 
        type="email" 
        id="customer-email" 
        required 
        maxlength="120"
        autocomplete="email"
        placeholder="budi@example.com"
        class="w-full bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm text-relyon-dark dark:text-white focus:outline-none focus:border-relyon-blue"
      />
    </div>

    <div>
      <label for="customer-phone" class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Nomor WhatsApp</label>
      <input 
        type="tel" 
        id="customer-phone" 
        required 
        inputmode="tel"
        autocomplete="tel"
        minlength="9"
        maxlength="16"
        pattern="[0-9+ ]{9,16}"
        placeholder="081234567890"
        class="w-full bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-2.5 text-sm text-relyon-dark dark:text-white focus:outline-none focus:border-relyon-blue"
      />
    </div>

    <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
      Setelah dikirim, kamu akan diarahkan ke WhatsApp untuk menerima instruksi pembayaran dari admin.
    </p>

    <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
      <span class="text-xs text-slate-500 dark:text-slate-400">Total Harga:</span>
      <span id="modal-total-price" class="text-lg font-extrabold text-relyon-blue dark:text-relyon-sky">Rp 0</span>
    </div>

    <button 
      type="submit" 
      id="submit-checkout-btn"
      class="w-full bg-relyon-blue hover:bg-relyon-dark text-white font-semibold py-3.5 rounded-xl shadow-lg shadow-relyon-blue/20 transition-all text-sm flex items-center justify-center gap-2 cursor-pointer"
    >
      <span id="submit-checkout-label">Pesan via WhatsApp</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18" />
      </svg>
    </button>

    <p id="checkout-message" class="hidden text-xs text-center font-medium" role="status" aria-live="polite"></p>
  </form>

</div>

<script>
  import { getCart, type CartItem } from '../lib/cartStore';
  import { supabase } from '../lib/supabase';

  // 📱 Masukkan nomor WhatsApp Admin / Store kamu di sini (Gunakan format 62...)
  const adminPhoneNumber = '6282112709889';

  const modal = document.getElementById('checkout-modal');
  const backdrop = document.getElementById('checkout-modal-backdrop');
  const closeBtn = document.getElementById('close-checkout-modal-btn');
  const form = document.getElementById('checkout-form');
  const totalPriceEl = document.getElementById('modal-total-price');
  const submitBtn = document.getElementById('submit-checkout-btn');
  const submitLabel = document.getElementById('submit-checkout-label');
  const messageEl = document.getElementById('checkout-message');
  let isSubmitting = false;

  type CreatedOrder = {
    order_id: string;
    order_number: string;
    total_amount: number | string;
  };

  const formatRupiah = (val: number) => {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
  };

  function toggleModal(open: boolean) {
    if (open) {
      const cart = getCart();
      const total = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
      if (totalPriceEl) totalPriceEl.innerText = formatRupiah(total);

      modal?.classList.remove('hidden');
      backdrop?.classList.remove('hidden');
      modal?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setTimeout(() => (document.getElementById('customer-name') as HTMLInputElement | null)?.focus(), 0);
    } else {
      modal?.classList.add('hidden');
      backdrop?.classList.add('hidden');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  window.addEventListener('open-checkout-modal', () => toggleModal(true));
  closeBtn?.addEventListener('click', () => toggleModal(false));
  backdrop?.addEventListener('click', () => toggleModal(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !isSubmitting && modal?.getAttribute('aria-hidden') === 'false') {
      toggleModal(false);
    }
  });

  function showMessage(text: string, type: 'error' | 'success') {
    if (!messageEl) return;
    messageEl.textContent = text;
    messageEl.classList.remove('hidden', 'text-rose-600', 'text-emerald-600');
    messageEl.classList.add(type === 'error' ? 'text-rose-600' : 'text-emerald-600');
  }

  function normalizePhone(value: string) {
    const digits = value.replace(/\D/g, '');
    if (digits.startsWith('0')) return `62${digits.slice(1)}`;
    if (digits.startsWith('62')) return digits;
    return digits;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isSubmitting) return;

    const formElement = form as HTMLFormElement;
    if (!formElement.checkValidity()) {
      formElement.reportValidity();
      return;
    }

    isSubmitting = true;
    if (submitBtn) submitBtn.setAttribute('disabled', 'true');
    if (submitLabel) submitLabel.textContent = 'Menyimpan pesanan...';
    messageEl?.classList.add('hidden');

    const name = (document.getElementById('customer-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('customer-email') as HTMLInputElement).value.trim().toLowerCase();
    const phone = normalizePhone((document.getElementById('customer-phone') as HTMLInputElement).value);
    const cart = getCart();

    if (cart.length === 0) {
      showMessage('Keranjang kosong. Silakan pilih produk terlebih dahulu.', 'error');
      isSubmitting = false;
      submitBtn?.removeAttribute('disabled');
      if (submitLabel) submitLabel.textContent = 'Pesan via WhatsApp';
      return;
    }

    if (phone.length < 10 || phone.length > 15) {
      showMessage('Nomor WhatsApp belum valid.', 'error');
      isSubmitting = false;
      submitBtn?.removeAttribute('disabled');
      if (submitLabel) submitLabel.textContent = 'Pesan via WhatsApp';
      return;
    }

    try {
      // Supabase menghitung harga, total, dan membuat seluruh data order.
      const { data: orderData, error: orderError } = await supabase
        .rpc('create_store_order', {
          p_customer_name: name,
          p_customer_email: email,
          p_customer_phone: phone,
          p_product_ids: cart.map((item) => item.id)
        })
        .single();

      if (orderError) throw orderError;
      if (!orderData) throw new Error('Supabase tidak mengembalikan data pesanan.');

      // Supabase belum memiliki generated type untuk RPC custom ini.
      const order = orderData as CreatedOrder;

      const orderNumber = order.order_number;
      const totalAmount = Number(order.total_amount);
      if (totalPriceEl) totalPriceEl.innerText = formatRupiah(totalAmount);

      // Pesan WhatsApp memakai nomor order dan total resmi dari Supabase.
      let itemsListText = '';
      cart.forEach((item, index) => {
        itemsListText += `${index + 1}. *${item.title}*\n`;
      });

      const waMessage = 
`Halo Admin *Relyon Creative*, saya ingin konfirmasi pesanan baru! 🚀

📌 *Detail Pesanan:*
• No. Order: *${orderNumber}*
• Nama: ${name}
• Email: ${email}
• No. WA: ${phone}

🛍️ *Item yang Dibeli:*
${itemsListText}
💰 *Total Pembayaran:* *${formatRupiah(totalAmount)}*

Mohon bantuannya untuk petunjuk pembayaran & pengiriman file aset digitalnya. Terima kasih!`;

      // Redirect ke WhatsApp.
      const encodedMessage = encodeURIComponent(waMessage);
      const waUrl = `https://wa.me/${adminPhoneNumber}?text=${encodedMessage}`;

      showMessage('Pesanan tersimpan. Membuka WhatsApp...', 'success');

      // Redirect di tab yang sama agar tidak diblokir popup browser mobile.
      window.location.assign(waUrl);

    } catch (err) {
      console.error('Checkout error:', err);
      showMessage('Pesanan belum berhasil disimpan. Silakan coba lagi.', 'error');
    } finally {
      isSubmitting = false;
      if (submitBtn) submitBtn.removeAttribute('disabled');
      if (submitLabel) submitLabel.textContent = 'Pesan via WhatsApp';
    }
  });
</script>