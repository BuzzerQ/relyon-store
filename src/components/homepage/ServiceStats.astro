<!-- Script Animated Counter -->
<script>
  function animateCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.counter');
    const duration = 1800; // Durasi animasi (ms)

    counters.forEach((counter) => {
      const target = parseInt(counter.getAttribute('data-target') || '0', 10);
      const isNumberFormat = counter.getAttribute('data-format') === 'number';
      const startTime = performance.now();

      function updateNumber(currentTime: number) {
        const elapsedTime = currentTime - startTime;
        const progress = Math.min(elapsedTime / duration, 1);
        
        // Easing function (easeOutQuad) biar gerakan angka makin halus pas mau nyampe target
        const easeProgress = 1 - (1 - progress) * (1 - progress);
        const currentCount = Math.floor(easeProgress * target);

        counter.innerText = isNumberFormat 
          ? currentCount.toLocaleString('id-ID') 
          : currentCount.toString();

        if (progress < 1) {
          requestAnimationFrame(updateNumber);
        } else {
          counter.innerText = isNumberFormat 
            ? target.toLocaleString('id-ID') 
            : target.toString();
        }
      }

      requestAnimationFrame(updateNumber);
    });
  }

  // Pakai IntersectionObserver biar countdown cuma jalan pas section-nya udah keliatan di layar
  const statsContainer = document.getElementById('stats-container');
  if (statsContainer) {
    let hasAnimated = false;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !hasAnimated) {
          hasAnimated = true;
          animateCounters();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    observer.observe(statsContainer);
  }
</script> 